<?php

/**
 * Implements hook_theme().
 */
function dynamic_form_analytics_theme() {
  $tpl_path = drupal_get_path('module', 'dynamic_form_analytics') . '/templates';
  return array(
    'dynamic_form_analytics_stat_card' => array(
      'variables' => array('label' => '', 'value' => '', 'icon' => '', 'modifier' => ''),
      'template'  => 'dynamic-form-analytics-stat-card',
      'path'      => $tpl_path,
    ),
    'dynamic_form_analytics_question_card' => array(
      'variables' => array('qid' => 0, 'label' => '', 'type' => '', 'body_html' => ''),
      'template'  => 'dynamic-form-analytics-question-card',
      'path'      => $tpl_path,
    ),
    'dynamic_form_analytics_form_page' => array(
      'variables' => array(
        'form_title'     => '',
        'form_id'        => 0,
        'responses_url'  => '',
        'analytics_url'  => '',
        'kpi_cards'      => array(),
        'has_trend'      => FALSE,
        'questions_html' => '',
      ),
      'template' => 'dynamic-form-analytics-form-page',
      'path'     => $tpl_path,
    ),
    'dynamic_form_analytics_global_page' => array(
      'variables' => array(
        'radar_url'     => '',
        'kpi_cards'     => array(),
        'has_trend'     => FALSE,
        'has_top_forms' => FALSE,
      ),
      'template' => 'dynamic-form-analytics-global-page',
      'path'     => $tpl_path,
    ),
    'dynamic_form_analytics_radar_page' => array(
      'variables' => array('back_url' => ''),
      'template'  => 'dynamic-form-analytics-radar-page',
      'path'      => $tpl_path,
    ),
  );
}

/**
 * Renders a KPI stat card via the theme system.
 *
 * @param string $label    Card label (translated).
 * @param string $value    Display value (number or string).
 * @param string $icon     Pre-rendered icon HTML.
 * @param string $modifier Color modifier: primary | success | accent | warning.
 */
function _dynamic_form_stat_card($label, $value, $icon, $modifier) {
  return theme('dynamic_form_analytics_stat_card', array(
    'label'    => $label,
    'value'    => $value,
    'icon'     => $icon,
    'modifier' => $modifier,
  ));
}

/**
 * Implements hook_permission().
 */
function dynamic_form_analytics_permission() {
  return array(
    'view form analytics' => array(
      'title'       => t('View form analytics'),
      'description' => t('Access the analytics dashboard with aggregated response charts.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function dynamic_form_analytics_menu() {
  $items = array();

  $items['dashboard/analytics'] = array(
    'title'            => 'Analytics',
    'page callback'    => 'dynamic_form_analytics_global_page',
    'access arguments' => array('view form analytics'),
    'file'             => 'includes/dynamic_form_analytics.global.inc',
    'type'             => MENU_CALLBACK,
  );

  $items['dashboard/forms/%/analytics'] = array(
    'title'           => 'Form Analytics',
    'page callback'   => 'dynamic_form_analytics_form_page',
    'page arguments'  => array(2),
    'access callback' => '_dynamic_form_edit_access',
    'access arguments'=> array(2),
    'file'            => 'includes/dynamic_form_analytics.form.inc',
    'type'            => MENU_CALLBACK,
  );

  $items['dashboard/analytics/wordcloud-data'] = array(
    'page callback'    => 'dynamic_form_analytics_wordcloud_data',
    'access arguments' => array('view form analytics'),
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/dynamic_form_analytics.wordcloud.inc',
  );

  $items['dashboard/analytics/wordcloud-questions/%'] = array(
    'page callback'    => 'dynamic_form_analytics_wordcloud_questions',
    'page arguments'   => array(3),
    'access arguments' => array('view form analytics'),
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/dynamic_form_analytics.wordcloud.inc',
  );

  $items['dashboard/analytics/wordcloud-tag-forms'] = array(
    'page callback'    => 'dynamic_form_analytics_wordcloud_tag_forms',
    'access arguments' => array('view form analytics'),
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/dynamic_form_analytics.wordcloud.inc',
  );

  $items['dashboard/analytics/radar'] = array(
    'title'            => 'Form Radar',
    'page callback'    => 'dynamic_form_analytics_radar_page',
    'access arguments' => array('view form analytics'),
    'file'             => 'includes/dynamic_form_analytics.radar.inc',
    'type'             => MENU_CALLBACK,
  );

  $items['dashboard/analytics/radar-data'] = array(
    'page callback'    => 'dynamic_form_analytics_radar_ajax',
    'access arguments' => array('view form analytics'),
    'type'             => MENU_CALLBACK,
    'file'             => 'includes/dynamic_form_analytics.radar.inc',
  );

  return $items;
}

/**
 * Implements hook_dynamic_form_dashboard_sidebar_items_alter().
 */
function dynamic_form_analytics_dynamic_form_dashboard_sidebar_items_alter(&$items) {
  if (user_access('view form analytics')) {
    $items = array('analytics' => array(
      'label' => t('Analytics'),
      'path'  => 'dashboard/analytics',
      'icon'  => '<i class="fa-solid fa-chart-line"></i>',
    )) + $items; // Moves the analytics item to the top of the sidebar.
  }
}
