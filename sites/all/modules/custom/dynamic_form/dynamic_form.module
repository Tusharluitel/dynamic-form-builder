/* =====================================================================
   QUESTION CACHE
   ===================================================================== */

/**
 * Returns all non-deleted questions for a form, ordered by position.

 * @param int $form_id
 * @return object[]
 */
function dynamic_form_get_questions($form_id) {
  $form_id = (int) $form_id;
  $cid     = 'dynamic_form:questions:' . $form_id;
  $cached  = cache_get($cid);
  if ($cached !== FALSE) {
    return $cached->data;
  }
  $questions = db_select('dynamic_form_questions', 'q')
    ->fields('q')
    ->condition('form_id', $form_id)
    ->isNull('deleted_at')
    ->orderBy('position', 'ASC')
    ->execute()
    ->fetchAll();
  cache_set($cid, $questions);
  return $questions;
}

/**
 * Clears the question cache for one form.
 *
 * Call after any insert, update, delete, or reorder on
 * dynamic_form_questions rows belonging to $form_id.
 *
 * @param int $form_id
 */
function dynamic_form_invalidate_questions_cache($form_id) {
  $form_id = (int) $form_id;
  cache_clear_all('dynamic_form:questions:' . $form_id, 'cache', FALSE);
  drupal_static_reset('dynamic_form_get_questions');
}

/* ===================================================================== */

/**
 * Appends one row to dynamic_form_audit_log.
 *
 * @param string     $entity_type  'form', 'section', or 'question'.
 * @param int        $entity_id    Primary key of the affected row.
 * @param string     $action       'created', 'updated', or 'deleted'.
 * @param array|null $old_value    State before the action (NULL for created).
 * @param array|null $new_value    State after the action (NULL for deleted).
 */
function _dynamic_form_audit_log($entity_type, $entity_id, $action, $old_value = NULL, $new_value = NULL) {
  global $user;
  db_insert('dynamic_form_audit_log')
    ->fields(array(
      'entity_type' => $entity_type,
      'entity_id'   => (int) $entity_id,
      'action'      => $action,
      'actor_uid'   => isset($user->uid) ? (int) $user->uid : 0,
      'old_value'   => $old_value !== NULL ? json_encode($old_value) : NULL,
      'new_value'   => $new_value !== NULL ? json_encode($new_value) : NULL,
      'ip_address'  => ip_address(),
      'created_at'  => REQUEST_TIME,
    ))
    ->execute();
}

/* =====================================================================
   FORM CRUD — ACCESS CALLBACKS
   ===================================================================== */

/**
 * Access callback for form/%/edit.
 *
 * Allows access if user has 'edit any form' or owns the form
 * and has 'edit own form'.
 */
function _dynamic_form_edit_access($form_id)
{
  global $user;

  if (user_access('edit any form')) {
    return TRUE;
  }

  if (user_access('edit own form')) {
    $form = entity_get_controller('dynamic_form_form')->loadSingle($form_id);
    if ($form && (int) $form->created_by === (int) $user->uid) {
      return TRUE;
    }
  }

  // Members with editor or reviewer role can access the builder.
  if ($user->uid) {
    $role = db_select('dynamic_form_members', 'm')
      ->fields('m', array('role'))
      ->condition('form_id', $form_id)
      ->condition('user_id', $user->uid)
      ->execute()
      ->fetchField();
    if (in_array($role, array('editor', 'reviewer'))) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Access callback for form/%/delete.
 *
 * Allows access if user has 'delete any form' or owns the form
 * and has 'delete own form'.
 */
function _dynamic_form_delete_access($form_id)
{
  global $user;

  if (user_access('delete any form')) {
    return TRUE;
  }

  if (user_access('delete own form')) {
    $form = entity_get_controller('dynamic_form_form')->loadSingle($form_id);
    return $form && (int) $form->created_by === (int) $user->uid;
  }

  return FALSE;
}

/* =====================================================================
   FORM CRUD — SLUG HELPER
   ===================================================================== */

/**
 * Generates a URL-friendly slug from a title.
 *
 * @param string $title
 *   The form title.
 *
 * @return string
 *   A lowercase, hyphenated slug.
 */
function _dynamic_form_generate_slug($title)
{
  // Lowercase, replace non-alphanumeric with hyphens, trim hyphens.
  $slug = drupal_strtolower($title);
  $slug = preg_replace('/[^a-z0-9]+/', '-', $slug);
  $slug = trim($slug, '-');

  // Ensure uniqueness by appending a number if needed.
  $base_slug = $slug;
  $counter = 1;
  while (db_select('dynamic_form_forms', 'f')
    ->fields('f', array('id'))
    ->condition('slug', $slug)
    ->execute()
    ->fetchField()) {
    $slug = $base_slug . '-' . $counter;
    $counter++;
  }

  return $slug;
}

/* =====================================================================
   FORM ALTERS
   ===================================================================== */

/**
 * Implements hook_form_alter().
 */
function dynamic_form_form_alter(&$form, &$form_state, $form_id) {
  // Override the default Drupal login form error messages.
  if ($form_id == 'user_login' || $form_id == 'user_login_block') {
    $form['#validate'][] = 'dynamic_form_custom_login_error_override';
  }
}

/**
 * Custom validation handler to override the core login error message.
 */
function dynamic_form_custom_login_error_override($form, &$form_state) {
  if (!empty($_SESSION['messages']['error'])) {
    foreach ($_SESSION['messages']['error'] as $key => $message) {
      // Check if the message contains the default Drupal error string.
      if (strpos($message, 'Sorry, unrecognized username or password') !== FALSE) {
        $_SESSION['messages']['error'][$key] = t('Incorrect email or password for login.');
      }
    }
  }
}

/* =====================================================================
   BACKGROUND EMAIL PROCESSING — CRON + BATCH
   ===================================================================== */

/**
 * Implements hook_cron().
 *
 * Triggered by an external cron job every minute:
 *
 * Processes each email queue in configurable batch sizes.
 */
function dynamic_form_cron() {
  module_load_include('inc', 'dynamic_form', 'includes/dynamic_form.invitations');
  module_load_include('inc', 'dynamic_form', 'includes/dynamic_form.members');

  _dynamic_form_process_queue_batch(
    'dynamic_form_invite_notify',
    '_dynamic_form_send_invite_notification',
    variable_get('dynamic_form_invite_batch_size', 20)
  );

  _dynamic_form_process_queue_batch(
    'dynamic_form_member_notify',
    '_dynamic_form_send_member_notification',
    variable_get('dynamic_form_member_batch_size', 20)
  );

  db_update('dynamic_form_invitations')
    ->fields(array('status' => 'expired'))
    ->condition('status', 'pending')
    ->condition('expires_at', REQUEST_TIME, '<')
    ->execute();
  
}

/**
 * Processes up to $batch_size items from a DrupalQueue in one cron run.
 */
function _dynamic_form_process_queue_batch($queue_name, $worker, $batch_size = 20) {
  $queue     = DrupalQueue::get($queue_name);
  $processed = 0;

  while ($processed < $batch_size) {
    $item = $queue->claimItem(60);
    if (!$item) {
      break;
    }

    try {
      call_user_func($worker, $item->data);
      $queue->deleteItem($item);
    }
    catch (Exception $e) {
      watchdog('dynamic_form', 'Email batch worker @worker failed: @msg',
        array('@worker' => $worker, '@msg' => $e->getMessage()),
        WATCHDOG_ERROR
      );
      $queue->releaseItem($item);
    }

    $processed++;
  }
}

/**
 * Implements hook_mail().
 */
function dynamic_form_mail($key, &$message, $params) {
  $language = $message['language'];
  $options  = array('langcode' => $language->language);

  switch ($key) {
    case 'member_added':
      $message['subject'] = t(
        'You have been added to the form: @title',
        array('@title' => $params['form_title']),
        $options
      );
      $message['body'][] = t('Hi @name,', array('@name' => $params['user_name']), $options);
      $message['body'][] = '';
      $message['body'][] = t(
        'You have been added as @role to the form "@title".',
        array('@role' => $params['role_label'], '@title' => $params['form_title']),
        $options
      );
      if (!empty($params['form_url'])) {
        $message['body'][] = '';
        $message['body'][] = t(
          'Access the form here: @url',
          array('@url' => $params['form_url']),
          $options
        );
      }
      $message['body'][] = '';
      $message['body'][] = t('This is an automated notification. Please do not reply to this email.', array(), $options);
      break;

    case 'invitation_sent':
      $message['subject'] = t(
        'You have been invited to: @title',
        array('@title' => $params['form_title']),
        $options
      );
      $message['body'][] = t('Hi,', array(), $options);
      $message['body'][] = '';
      $message['body'][] = t(
        '@inviter has invited you to collaborate on "@title" as @role.',
        array(
          '@inviter' => $params['inviter_name'],
          '@title'   => $params['form_title'],
          '@role'    => $params['role_label'],
        ),
        $options
      );
      $message['body'][] = '';
      $message['body'][] = t('Click the link below to accept your invitation (expires in 7 days):', array(), $options);
      $message['body'][] = '';
      $message['body'][] = $params['accept_url'];
      $message['body'][] = '';
      $message['body'][] = t('If you do not have an account, you will be asked to create one first.', array(), $options);
      $message['body'][] = '';
      $message['body'][] = t('This is an automated notification. Please do not reply to this email.', array(), $options);
      break;
  }
}

/**
 * Normalizes a raw tag string for storage in dynamic_form_tags.
 *
 * @param string $raw
 * @return string|false  Normalized tag, or FALSE when result is empty.
 */
function _dynamic_form_normalize_tag($raw)
{
  $tag = html_entity_decode($raw, ENT_QUOTES, 'UTF-8');
  $tag = mb_strtolower($tag, 'UTF-8');
  $tag = preg_replace('/[^\p{L}\p{N}]+/u', ' ', $tag);
  $tag = trim($tag);

  return $tag !== '' ? $tag : FALSE;
}
