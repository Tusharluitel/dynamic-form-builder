<?php

/**
 * Implements hook_init().
 */
function dynamic_form_init() {
  _dynamic_form_api_rate_limit();
}


function _dynamic_form_api_rate_limit() {
  // Strip the query string and check the path suffix.
  $path = strtok($_SERVER['REQUEST_URI'], '?');
  if (substr($path, -5) !== '.json') {
    return;
  }

  $ip  = ip_address();
  $uid = (int) $GLOBALS['user']->uid;

  $ip_threshold   = (int) variable_get('dynamic_form_rate_limit_ip_threshold', 60);
  $ip_window      = (int) variable_get('dynamic_form_rate_limit_ip_window', 60);
  $user_threshold = (int) variable_get('dynamic_form_rate_limit_user_threshold', 120);
  $user_window    = (int) variable_get('dynamic_form_rate_limit_user_window', 60);

  // Per-IP limit — applies to everyone (anonymous + authenticated).
  if (!flood_is_allowed('dynamic_form_api_ip', $ip_threshold, $ip_window, $ip)) {
    _dynamic_form_rate_limit_deny($ip_window);
    // _dynamic_form_rate_limit_deny() calls drupal_exit() — no return.
  }
  flood_register_event('dynamic_form_api_ip', $ip_window, $ip);

  // Per-user limit — authenticated users only, keyed by uid so it is
  // independent of IP (useful behind proxies / shared NAT).
  if ($uid > 0) {
    $flood_key = 'uid:' . $uid;
    if (!flood_is_allowed('dynamic_form_api_uid', $user_threshold, $user_window, $flood_key)) {
      _dynamic_form_rate_limit_deny($user_window);
    }
    flood_register_event('dynamic_form_api_uid', $user_window, $flood_key);
  }
}

/**
 * Sends HTTP 429 Too Many Requests and exits.
 *
 * Uses raw header() calls because we are bypassing Drupal's normal page
 * render pipeline — drupal_add_http_header() queues headers that would
 * only be flushed by drupal_send_page(), which never runs here.
 *
 * @param int $retry_after  Seconds until the current flood window resets.
 */
function _dynamic_form_rate_limit_deny($retry_after = 60) {
  header('HTTP/1.1 429 Too Many Requests');
  header('Retry-After: ' . (int) $retry_after);
  header('Content-Type: application/json; charset=utf-8');
  print drupal_json_encode(array(
    'error'       => 'rate_limit_exceeded',
    'message'     => 'Too many requests. Please wait before retrying.',
    'retry_after' => (int) $retry_after,
  ));
  drupal_exit();
}

/**
 * Returns (and caches to a temp file) a WS-specific HMAC secret.
 *
 * ws_server.php has no Drupal DB access, so the secret is derived from
 * Drupal's private key and written to a temp file that both processes can read.
 * The file is mode 0600 and lives outside the web root in sys_get_temp_dir().
 *
 * @return string  64-char hex secret.
 */
function _dynamic_form_ws_secret() {
  $secret = drupal_hmac_base64('dfb_ws_secret', drupal_get_private_key() . drupal_get_hash_salt());
  // Use DRUPAL_ROOT so the path is identical regardless of which OS user runs
  // the process — sys_get_temp_dir() differs between Apache and the CLI user.
  $file = DRUPAL_ROOT . '/.dfb_ws_secret';
  if (!file_exists($file) || trim(file_get_contents($file)) !== $secret) {
    file_put_contents($file, $secret, LOCK_EX);
    @chmod($file, 0600);
  }
  return $secret;
}

/**
 * Returns an AJAX command array that triggers a DFBToast notification.
 *
 * @param string $type     One of: success, error, warning, info.
 * @param string $message  The message to display (already translated).
 */
function ajax_command_dfb_toast($type, $message) {
  return array(
    'command'    => 'dfbToast',
    'toast_type' => $type,
    'message'    => $message,
  );
}

/**
 * Implements hook_entity_info().
 *
 * Registers four read-only entity types exposed by restws:
 *   - dynamic_form_form           → /dynamic_form_form/{id}.json
 *   - dynamic_form_section        → /dynamic_form_section/{id}.json
 *   - dynamic_form_question       → /dynamic_form_question/{id}.json
 *   - dynamic_form_question_option → /dynamic_form_question_option/{id}.json
 *
 * All four use DynamicFormSoftDeleteEntityController so deleted_at rows are
 * hidden from entity_load() and therefore from the API.
 */
function dynamic_form_entity_info() {
  $info['dynamic_form_form'] = array(
    'label'            => t('Dynamic Form'),
    'plural label'     => t('Dynamic Forms'),
    'base table'       => 'dynamic_form_forms',
    'entity keys'      => array('id' => 'id', 'label' => 'title'),
    'module'           => 'dynamic_form',
    'controller class' => 'DynamicFormFormController',
    'access callback'  => '_dynamic_form_form_entity_access',
  );

  $info['dynamic_form_section'] = array(
    'label'            => t('Dynamic Form Section'),
    'plural label'     => t('Dynamic Form Sections'),
    'base table'       => 'dynamic_form_sections',
    'entity keys'      => array('id' => 'id', 'label' => 'name'),
    'module'           => 'dynamic_form',
    'controller class' => 'DynamicFormSectionController',
    'access callback'  => '_dynamic_form_section_entity_access',
  );

  $info['dynamic_form_question'] = array(
    'label'            => t('Dynamic Form Question'),
    'plural label'     => t('Dynamic Form Questions'),
    'base table'       => 'dynamic_form_questions',
    'entity keys'      => array('id' => 'id', 'label' => 'label'),
    'module'           => 'dynamic_form',
    'controller class' => 'DynamicFormQuestionController',
    'access callback'  => '_dynamic_form_question_entity_access',
  );

  $info['dynamic_form_question_option'] = array(
    'label'            => t('Dynamic Form Question Option'),
    'plural label'     => t('Dynamic Form Question Options'),
    'base table'       => 'dynamic_form_question_options',
    'entity keys'      => array('id' => 'id', 'label' => 'option_label'),
    'module'           => 'dynamic_form',
    'controller class' => 'DynamicFormQuestionOptionController',
    'access callback'  => '_dynamic_form_question_option_entity_access',
  );

  return $info;
}

/**
 * Implements hook_entity_property_info().
 *
 * Declares typed properties so restws can serialise each entity. Soft-delete
 * columns (deleted_at, deleted_by) are intentionally omitted — the controller
 * filters those rows out before they ever reach the formatter.
 */
