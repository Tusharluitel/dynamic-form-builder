<?php

/**
 * @file
 * Dynamic Form REST WS — read-only REST API v1 for responses and answers.
 *
 * Authentication: Bearer token (preferred) or HTTP Basic Auth (fallback).
 * All endpoints are GET-only and return JSON.
 * URL versioning: /api/v1/...
 */

/**
 * Implements hook_permission().
 */
function dynamic_form_restws_permission() {
  return array(
    'access rest api' => array(
      'title'       => t('Access Dynamic Form REST API'),
      'description' => t('Allows a user account to authenticate via Bearer token or Basic Auth and make requests to the REST API.'),
    ),
    'administer rest api tokens' => array(
      'title'       => t('Administer Dynamic Form REST API Tokens'),
      'description' => t('Generate and revoke Bearer tokens for the Dynamic Form REST API.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function dynamic_form_restws_menu() {
  $base = array(
    'access callback' => TRUE,
    'type'            => MENU_CALLBACK,
    'file'            => 'includes/dynamic_form_restws.v1.inc',
  );

  // GET api/v1/forms/{form_id}/responses
  $items['api/v1/forms/%/responses'] = $base + array(
    'page callback'  => 'dynamic_form_restws_v1_responses_list',
    'page arguments' => array(3),
  );

  // GET api/v1/forms/{form_id}/responses/{response_id}
  $items['api/v1/forms/%/responses/%'] = $base + array(
    'page callback'  => 'dynamic_form_restws_v1_response_detail',
    'page arguments' => array(3, 5),
  );

  // Admin: token list.
  $items['admin/config/services/dynamic-form-api-tokens'] = array(
    'title'            => 'Dynamic Form API Tokens',
    'description'      => 'Manage Bearer tokens for the Dynamic Form REST API.',
    'page callback'    => 'dynamic_form_restws_admin_tokens_page',
    'access arguments' => array('administer rest api tokens'),
    'file'             => 'includes/dynamic_form_restws.admin.inc',
    'type'             => MENU_NORMAL_ITEM,
  );

  $items['admin/config/services/dynamic-form-api-tokens/list'] = array(
    'title'  => 'Tokens',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );

  // Admin: generate token.
  $items['admin/config/services/dynamic-form-api-tokens/add'] = array(
    'title'            => 'Generate Token',
    'page callback'    => 'drupal_get_form',
    'page arguments'   => array('dynamic_form_restws_admin_token_add_form'),
    'access arguments' => array('administer rest api tokens'),
    'file'             => 'includes/dynamic_form_restws.admin.inc',
    'type'             => MENU_LOCAL_TASK,
    'weight'           => 0,
  );

  // Admin: revoke token confirmation.
  $items['admin/config/services/dynamic-form-api-tokens/%/revoke'] = array(
    'title'            => 'Revoke Token',
    'page callback'    => 'drupal_get_form',
    'page arguments'   => array('dynamic_form_restws_admin_token_revoke_form', 4),
    'access arguments' => array('administer rest api tokens'),
    'file'             => 'includes/dynamic_form_restws.admin.inc',
    'type'             => MENU_CALLBACK,
  );

  return $items;
}

/* =====================================================================
   AUTHENTICATION
   ===================================================================== */

/**
 * Authenticates a request via Bearer token or HTTP Basic Auth.
 *
 * Checks the Authorization header for a Bearer token first. If absent,
 * falls back to HTTP Basic Auth credentials (PHP_AUTH_* or Authorization
 * header). Returns FALSE when credentials are missing, invalid, or the
 * account lacks the 'access rest api' permission.
 *
 * @return object|FALSE  Drupal user object or FALSE.
 */
function _dynamic_form_restws_authenticate() {
  // Collect the raw Authorization header from whichever server var is set.
  $auth_header = NULL;
  if (!empty($_SERVER['HTTP_AUTHORIZATION'])) {
    $auth_header = $_SERVER['HTTP_AUTHORIZATION'];
  }
  elseif (!empty($_SERVER['REDIRECT_HTTP_AUTHORIZATION'])) {
    // Apache CGI/rewrite workaround.
    $auth_header = $_SERVER['REDIRECT_HTTP_AUTHORIZATION'];
  }

  // Bearer token (preferred).
  if ($auth_header !== NULL && strncmp($auth_header, 'Bearer ', 7) === 0) {
    return _dynamic_form_restws_authenticate_token(trim(substr($auth_header, 7)));
  }

  // Basic Auth fallback.
  $username = NULL;
  $password = NULL;

  if (!empty($_SERVER['PHP_AUTH_USER'])) {
    $username = $_SERVER['PHP_AUTH_USER'];
    $password = isset($_SERVER['PHP_AUTH_PW']) ? $_SERVER['PHP_AUTH_PW'] : '';
  }
  elseif ($auth_header !== NULL) {
    list($username, $password) = _dynamic_form_restws_parse_basic_header($auth_header);
  }

  if ($username === NULL || $password === NULL) {
    return FALSE;
  }

  $uid = user_authenticate($username, $password);
  if (!$uid) {
    return FALSE;
  }

  $account = user_load($uid);
  if (!$account || !user_access('access rest api', $account)) {
    return FALSE;
  }

  return $account;
}

/**
 * Authenticates via a raw Bearer token string.
 *
 * Hashes the token with SHA-256, looks it up in dynamic_form_api_tokens,
 * verifies it is not revoked, loads the associated user, and updates
 * last_used_at on success.
 *
 * @param string $raw_token  The plain token from the Authorization header.
 * @return object|FALSE  Drupal user object or FALSE.
 */
function _dynamic_form_restws_authenticate_token($raw_token) {
  if (empty($raw_token)) {
    return FALSE;
  }

  $token_hash = hash('sha256', $raw_token);

  $record = db_select('dynamic_form_api_tokens', 't')
    ->fields('t', array('id', 'uid', 'revoked_at'))
    ->condition('token_hash', $token_hash)
    ->execute()
    ->fetchObject();

  if (!$record || $record->revoked_at) {
    return FALSE;
  }

  $account = user_load($record->uid);
  if (!$account || !user_access('access rest api', $account)) {
    return FALSE;
  }

  // Track last usage without blocking the response.
  db_update('dynamic_form_api_tokens')
    ->fields(array('last_used_at' => REQUEST_TIME))
    ->condition('id', $record->id)
    ->execute();

  return $account;
}

/**
 * Parses a "Basic <base64>" Authorization header value.
 *
 * @param string $header  Raw header value.
 * @return array  Two-element array [username, password], or [NULL, NULL].
 */
function _dynamic_form_restws_parse_basic_header($header) {
  if (strncmp($header, 'Basic ', 6) !== 0) {
    return array(NULL, NULL);
  }
  $decoded = base64_decode(substr($header, 6), TRUE);
  if ($decoded === FALSE) {
    return array(NULL, NULL);
  }
  $parts = explode(':', $decoded, 2);
  if (count($parts) !== 2) {
    return array(NULL, NULL);
  }
  return $parts;
}

/* =====================================================================
   ACCESS CONTROL
   ===================================================================== */

/**
 * Checks whether $account may view responses for the given form.
 *
 * @param int    $form_id
 * @param object $account  Drupal user object.
 * @return bool
 */
function _dynamic_form_restws_can_view_responses($form_id, $account) {
  if (user_access('view any form responses', $account)) {
    return TRUE;
  }
  if (!user_access('view own form responses', $account)) {
    return FALSE;
  }

  $created_by = db_select('dynamic_form_forms', 'f')
    ->fields('f', array('created_by'))
    ->condition('id', $form_id)
    ->isNull('deleted_at')
    ->execute()
    ->fetchField();

  if ($created_by === FALSE) {
    return FALSE;
  }
  if ((int) $created_by === (int) $account->uid) {
    return TRUE;
  }

  return (bool) db_select('dynamic_form_members', 'm')
    ->condition('form_id', $form_id)
    ->condition('user_id', $account->uid)
    ->condition('role', array('owner', 'editor'), 'IN')
    ->isNull('deleted_at')
    ->countQuery()->execute()->fetchField();
}

/* =====================================================================
   JSON RESPONSE HELPERS
   ===================================================================== */

/**
 * Outputs a JSON response and halts Drupal page rendering.
 *
 * @param array $data         Response payload.
 * @param int   $status_code  HTTP status code (default 200).
 */
function _dynamic_form_restws_send_json(array $data, $status_code = 200) {
  static $texts = array(
    200 => 'OK',
    400 => 'Bad Request',
    401 => 'Unauthorized',
    403 => 'Forbidden',
    404 => 'Not Found',
    405 => 'Method Not Allowed',
  );
  $text = isset($texts[$status_code]) ? $texts[$status_code] : 'Error';
  drupal_add_http_header('Status', $status_code . ' ' . $text);
  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');
  drupal_add_http_header('Cache-Control', 'no-store, no-cache, must-revalidate');
  drupal_add_http_header('X-Content-Type-Options', 'nosniff');
  echo drupal_json_encode($data);
  drupal_exit();
}

/**
 * Outputs a JSON error envelope and halts.
 *
 * @param int    $status_code
 * @param string $message      Human-readable error description.
 */
function _dynamic_form_restws_send_error($status_code, $message) {
  if ($status_code === 401) {
    drupal_add_http_header('WWW-Authenticate', 'Bearer realm="Dynamic Form API v1"');
  }
  _dynamic_form_restws_send_json(array(
    'api_version' => 'v1',
    'error'       => array(
      'code'    => $status_code,
      'message' => $message,
    ),
  ), $status_code);
}
